{
  "description": "Ask the person before a Frends tool leaves the draft stage, and tell a new session that the server serves its own guides.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__plugin_frends_frends__(create_process_from_draft|deploy_process|start_process|import_task|create_environment_variable)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/ask-before-leaving-the-draft.js"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/session-start.js"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
